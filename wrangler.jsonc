{
  "name": "spinal-support",
  "main": "worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b"
  }
}
